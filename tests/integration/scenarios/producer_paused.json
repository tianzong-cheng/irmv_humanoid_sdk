{
  "name": "producer_paused",
  "description": "The producer is SIGSTOPped while its target is tracking: the command timeout returns the machine to Damping on the exact receive deadline and keeps the session; after SIGCONT a new authorization is needed before the runtime commands the target again.",
  "domain": 206,
  "runtime": {
    "config": "config/sdk.json",
    "fake_scenario": "tests/support/fake_ramp.json",
    "output_trace": "trace_run%d.jsonl"
  },
  "steps": [
    {
      "action": "start_runtime"
    },
    {
      "action": "wait_log",
      "pattern": "state=\"ZeroTorque\"",
      "timeout_s": 15
    },
    {
      "action": "client",
      "name": "producer",
      "mode": "producer",
      "scenario": "producer",
      "background": true,
      "args": [
        "--producer-id",
        "0102030405060708090a0b0c0d0e0f33",
        "--rate",
        "50"
      ]
    },
    {
      "action": "client",
      "name": "observer",
      "mode": "observer",
      "scenario": "observe",
      "background": true
    },
    {
      "action": "client",
      "name": "supervisor",
      "mode": "supervisor",
      "scenario": "producer_paused",
      "background": true,
      "timeout_s": 30,
      "args": [
        "--producer-id",
        "0102030405060708090a0b0c0d0e0f33",
        "--rate",
        "50"
      ]
    },
    {
      "action": "wait_log",
      "pattern": "AuthorizationGranted",
      "timeout_s": 15
    },
    {
      "action": "sleep_ms",
      "ms": 400
    },
    {
      "action": "signal_client",
      "name": "producer",
      "signal": "SIGSTOP"
    },
    {
      "action": "sleep_ms",
      "ms": 250,
      "note": "the command timeout is 100 ms; the supervisor re-authorizes"
    },
    {
      "action": "signal_client",
      "name": "producer",
      "signal": "SIGCONT"
    },
    {
      "action": "wait_client",
      "name": "supervisor",
      "timeout_s": 30,
      "allow_exit": [
        0
      ]
    },
    {
      "action": "stop_runtime",
      "signal": "SIGTERM",
      "timeout_s": 10,
      "expect_clean": true
    },
    {
      "action": "signal_client",
      "name": "producer",
      "signal": "SIGTERM"
    },
    {
      "action": "wait_client",
      "name": "producer",
      "timeout_s": 15,
      "allow_exit": [
        0,
        -15
      ]
    },
    {
      "action": "signal_client",
      "name": "observer",
      "signal": "SIGTERM"
    },
    {
      "action": "wait_client",
      "name": "observer",
      "timeout_s": 15,
      "allow_exit": [
        0,
        -15
      ]
    }
  ],
  "checks": [
    {
      "check": "fallback",
      "params": {
        "client": "observer",
        "reason": "CommandTimeout",
        "state": "Damping",
        "session_required": true,
        "base": {
          "kind": "signal",
          "client": "producer",
          "signal": "SIGSTOP"
        },
        "min_ms": 60,
        "max_ms": 300
      }
    },
    {
      "check": "client_check",
      "params": {
        "client": "supervisor",
        "names": [
          "command_timeout_damping",
          "fallback_keeps_session",
          "commands_resumed",
          "zero_torque_applied"
        ]
      }
    },
    {
      "check": "target_expiry",
      "params": {
        "file": "trace_run1.jsonl",
        "command_us": 100000,
        "epoch_index": 0
      }
    },
    {
      "check": "trace_complete",
      "params": {
        "file": "trace_run1.jsonl",
        "min_ticks": 1200
      }
    },
    {
      "check": "deadlines",
      "params": {
        "file": "trace_run1.jsonl",
        "max_gap_us": 10000,
        "min_rate_hz": 450
      }
    },
    {
      "check": "overruns",
      "params": {
        "max_worst_overrun_us": 20000
      }
    }
  ]
}
