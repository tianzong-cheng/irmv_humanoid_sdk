<mujoco model="simulation_capability">
  <option timestep="0.001" gravity="0 0 -9.81" iterations="100" tolerance="1e-12"/>
  <worldbody>
    <geom type="plane" size="5 5 .1"/>
    <body name="base" pos="0 0 1">
      <freejoint name="root"/>
      <geom type="sphere" size=".1" mass="1"/>
      <site name="imu"/>
      <body name="rotor">
        <joint name="joint" type="hinge" axis="0 0 1" damping="0"/>
        <geom type="sphere" size=".05" mass="1" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>
  <equality>
    <weld name="support" body1="base" solref="0.001 1" solimp=".9999 .9999 .001"/>
  </equality>
  <actuator><motor name="torque" joint="joint" gear="1" ctrllimited="false" forcelimited="false"/></actuator>
  <sensor>
    <framequat name="orientation" objtype="site" objname="imu"/>
    <gyro name="angular_velocity" site="imu"/>
    <accelerometer name="specific_force" site="imu"/>
  </sensor>
</mujoco>
