{
  "name": "application_fault",
  "description": "The fake backend refuses the torque write, the runtime latches WriteFailed and the application reports behavior=Fault with the lower runtime=Fault - it never sends a target and never claims a stop. Once the write path has healed and the runtime's recovery window has opened, a single Reset clears the latch through a confirmed fresh ZeroTorque into Standby, which is the contract the key documents. The software emergency stop then latches the upper Fault while the healthy lower layer keeps its own Damping output, and a second Reset is the only way back. The runtime stops cleanly from ZeroTorque, and the application, left without a lower layer, exits bounded with stop=unknown.",
  "domain": 217,
  "runtime": {
    "config": "config/sdk.json",
    "fake_scenario": "tests/support/fake_write_refused.json",
    "output_trace": "trace_run%d.jsonl"
  },
  "application": {},
  "steps": [
    {
      "action": "start_runtime"
    },
    {
      "action": "wait_log",
      "pattern": "FaultLatched.*fault=\"WriteFailed\"",
      "timeout_s": 15
    },
    {
      "action": "start_application"
    },
    {
      "action": "wait_application_log",
      "pattern": "behavior=Fault runtime=Fault",
      "timeout_s": 15
    },
    {
      "action": "wait_log",
      "pattern": "RecoveryReady",
      "after_now": true,
      "timeout_s": 15,
      "note": "the runtime's own recovery window opens although the latch stays"
    },
    {
      "action": "application_keys",
      "keys": "r"
    },
    {
      "action": "wait_application_log",
      "pattern": "behavior=Standby runtime=ZeroTorque",
      "timeout_s": 15,
      "note": "one Reset is enough: the confirmed fresh ZeroTorque clears the latch"
    },
    {
      "action": "sleep_ms",
      "ms": 400,
      "note": "the Reset key has a 250 ms behavioural repeat guard"
    },
    {
      "action": "application_keys",
      "keys": " ",
      "note": "the software emergency stop on a healthy link"
    },
    {
      "action": "wait_application_log",
      "pattern": "behavior=Fault runtime=Damping output=Damping",
      "timeout_s": 10
    },
    {
      "action": "application_keys",
      "keys": "r"
    },
    {
      "action": "wait_application_log",
      "pattern": "behavior=Standby runtime=ZeroTorque",
      "timeout_s": 10
    },
    {
      "action": "stop_runtime",
      "signal": "SIGTERM",
      "timeout_s": 10,
      "expect_clean": true
    },
    {
      "action": "stop_application",
      "keys": "x",
      "timeout_s": 8,
      "expect_code": 3
    }
  ],
  "checks": [
    {
      "check": "log_sequence",
      "params": {
        "file": "application_run1.log",
        "sequence": [
          "behavior=Fault runtime=Fault",
          "behavior=Standby runtime=ZeroTorque",
          "behavior=Fault runtime=Damping output=Damping",
          "behavior=Standby runtime=ZeroTorque",
          "application: exit stop=unknown lower=Unknown"
        ],
        "forbid": [
          "behavior=Ready",
          "behavior=Locomotion",
          "stop=confirmed"
        ]
      }
    },
    {
      "check": "log_sequence",
      "params": {
        "file": "runtime_run1.log",
        "sequence": [
          "fault=\"WriteFailed\"",
          "RecoveryReady",
          "ResetApplied",
          "StopApplied {event=8 from=\"ZeroTorque\" to=\"Damping\"",
          "StopApplied {event=8 from=\"Damping\" to=\"ZeroTorque\""
        ],
        "forbid": [
          "CommandTimeout",
          "SourceStateTimeout"
        ]
      }
    },
    {
      "check": "trace_complete",
      "params": {
        "file": "trace_run1.jsonl",
        "min_ticks": 1200
      }
    },
    {
      "check": "deadlines",
      "params": {
        "file": "trace_run1.jsonl",
        "max_gap_us": 10000,
        "min_rate_hz": 450
      }
    },
    {
      "check": "overruns",
      "params": {
        "max_worst_overrun_us": 20000
      }
    }
  ]
}
