{
  "name": "slow_logger",
  "description": "The log consumer is blocked on purpose (the runtime's output pipe is not read) while the flood produces events: the logger drops events, and the control loop keeps its deadlines with a complete output trace.",
  "domain": 209,
  "runtime": {
    "config": "config/sdk.json",
    "fake_scenario": "tests/support/fake_ramp.json",
    "output_trace": "trace_run%d.jsonl",
    "config_overrides": {
      "telemetry.queue_capacity": 64
    }
  },
  "steps": [
    {
      "action": "start_runtime"
    },
    {
      "action": "sleep_ms",
      "ms": 1200,
      "note": "the runtime is left to boot without draining its log"
    },
    {
      "action": "client",
      "name": "producer",
      "mode": "producer",
      "scenario": "producer",
      "background": true,
      "args": [
        "--producer-id",
        "0102030405060708090a0b0c0d0e0f33",
        "--rate",
        "50"
      ]
    },
    {
      "action": "client",
      "name": "flood",
      "mode": "supervisor",
      "scenario": "log_volume",
      "background": true,
      "args": [
        "--rate",
        "1000"
      ]
    },
    {
      "action": "sleep_ms",
      "ms": 500
    },
    {
      "action": "client",
      "name": "supervisor",
      "mode": "supervisor",
      "scenario": "slow_logger",
      "timeout_s": 30,
      "args": [
        "--producer-id",
        "0102030405060708090a0b0c0d0e0f33",
        "--rate",
        "50"
      ]
    },
    {
      "action": "drain_runtime_logs",
      "ms": 200,
      "note": "the blocked log consumer is released here"
    },
    {
      "action": "stop_runtime",
      "signal": "SIGTERM",
      "timeout_s": 10,
      "expect_clean": true
    },
    {
      "action": "signal_client",
      "name": "flood",
      "signal": "SIGTERM"
    },
    {
      "action": "wait_client",
      "name": "flood",
      "timeout_s": 15,
      "allow_exit": [
        0,
        -15
      ]
    },
    {
      "action": "signal_client",
      "name": "producer",
      "signal": "SIGTERM"
    },
    {
      "action": "wait_client",
      "name": "producer",
      "timeout_s": 15,
      "allow_exit": [
        0,
        -15
      ]
    }
  ],
  "checks": [
    {
      "check": "logger_dropped",
      "params": {
        "min": 1
      }
    },
    {
      "check": "client_check",
      "params": {
        "client": "supervisor",
        "names": [
          "stop_under_flood",
          "zero_torque_applied"
        ]
      }
    },
    {
      "check": "targets_served",
      "params": {
        "file": "trace_run1.jsonl",
        "min_command_seqs": 5
      }
    },
    {
      "check": "trace_complete",
      "params": {
        "file": "trace_run1.jsonl",
        "min_ticks": 1000
      }
    },
    {
      "check": "deadlines",
      "params": {
        "file": "trace_run1.jsonl",
        "max_gap_us": 10000,
        "min_rate_hz": 450
      }
    },
    {
      "check": "overruns",
      "params": {
        "max_worst_overrun_us": 20000
      }
    }
  ]
}
