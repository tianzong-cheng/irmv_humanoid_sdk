{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irmv.example/schema/runtime-sdk-v1.json",
  "title": "IRMV fake-only runtime configuration",
  "type": "object",
  "$comment": "Conforming validation MUST evaluate the irmv-joint-name format as a nonempty string whose UTF-8 encoding is at most 64 bytes; validators that ignore format annotations do not implement this contract. LoadConfig additionally enforces cross-field joint-name completeness, unique names, position_min < position_max, boot deadline ordering, minimum frequency versus control_hz, and state-window coverage. LoadApplicationConfig enforces joint-map completeness for the application sections, position limits, gain sign rules, trajectory and supervision ordering, and the input binding reservation; the $comments below state the units and the rules the schema cannot express.",
  "required": [
    "schema_version",
    "deployment",
    "backend",
    "robot",
    "runtime",
    "application",
    "input",
    "telemetry",
    "dds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deployment": {
      "const": "fake_only"
    },
    "backend": {
      "const": "fake"
    },
    "robot": {
      "type": "object",
      "required": ["units", "joints"],
      "properties": {
        "units": {
          "type": "object",
          "required": ["position", "velocity", "torque"],
          "properties": {
            "position": {
              "const": "rad"
            },
            "velocity": {
              "const": "rad_s"
            },
            "torque": {
              "const": "Nm"
            }
          }
        },
        "joints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["name", "position_min", "position_max"],
            "properties": {
              "name": {
                "$ref": "#/$defs/jointName"
              },
              "position_min": {
                "type": "number"
              },
              "position_max": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "control_hz",
        "damping",
        "safety",
        "boot",
        "recovery",
        "imu_required",
        "continuity",
        "state_window_capacity"
      ],
      "properties": {
        "control_hz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "damping": {
          "type": "object",
          "required": ["kd"],
          "properties": {
            "kd": {
              "$ref": "#/$defs/positiveJointMap"
            }
          }
        },
        "safety": {
          "type": "object",
          "required": [
            "joint_velocity_limits",
            "torque_limits",
            "target_velocity_limits",
            "timeouts"
          ],
          "properties": {
            "joint_velocity_limits": {
              "$ref": "#/$defs/positiveJointMap"
            },
            "torque_limits": {
              "$ref": "#/$defs/positiveJointMap"
            },
            "target_velocity_limits": {
              "$ref": "#/$defs/positiveJointMap"
            },
            "timeouts": {
              "type": "object",
              "required": [
                "command_us",
                "source_state_us",
                "feedback_us",
                "imu_us",
                "supervisor_us"
              ],
              "properties": {
                "command_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                },
                "source_state_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                },
                "feedback_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                },
                "imu_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                },
                "supervisor_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                }
              }
            }
          }
        },
        "boot": {
          "type": "object",
          "required": [
            "frequency_grace_us",
            "healthy_window_us",
            "deadline_us",
            "minimum_frequency_hz"
          ],
          "properties": {
            "frequency_grace_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "healthy_window_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "deadline_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "minimum_frequency_hz": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "recovery": {
          "type": "object",
          "required": ["healthy_window_us", "minimum_frequency_hz"],
          "properties": {
            "healthy_window_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "minimum_frequency_hz": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        },
        "imu_required": {
          "type": "boolean"
        },
        "continuity": {
          "type": "object",
          "required": ["position_delta", "velocity_delta", "torque_delta"],
          "properties": {
            "position_delta": {
              "$ref": "#/$defs/nonNegativeJointMap"
            },
            "velocity_delta": {
              "$ref": "#/$defs/nonNegativeJointMap"
            },
            "torque_delta": {
              "$ref": "#/$defs/nonNegativeJointMap"
            }
          }
        },
        "state_window_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    },
    "application": {
      "type": "object",
      "required": ["initialization", "supervision", "policy"],
      "properties": {
        "initialization": {
          "type": "object",
          "required": ["target_position", "gains", "trajectory"],
          "properties": {
            "target_position": {
              "$ref": "#/$defs/positionJointMap"
            },
            "gains": {
              "$ref": "#/$defs/initializationGainMap"
            },
            "trajectory": {
              "type": "object",
              "required": [
                "duration_us",
                "position_tolerance",
                "velocity_tolerance",
                "stable_window_us",
                "deadline_us"
              ],
              "properties": {
                "duration_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                },
                "position_tolerance": {
                  "$ref": "#/$defs/positiveNumber",
                  "$comment": "rad"
                },
                "velocity_tolerance": {
                  "$ref": "#/$defs/positiveNumber",
                  "$comment": "rad/s"
                },
                "stable_window_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                },
                "deadline_us": {
                  "$ref": "#/$defs/positiveTimeUs"
                }
              },
              "$comment": "All times are microseconds. LoadApplicationConfig requires deadline_us > duration_us and deadline_us >= duration_us + stable_window_us, so the stable window can complete inside the deadline."
            }
          }
        },
        "supervision": {
          "type": "object",
          "required": [
            "target_period_us",
            "heartbeat_period_us",
            "request_retry_us",
            "request_deadline_us",
            "state_timeout_us"
          ],
          "properties": {
            "target_period_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "heartbeat_period_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "request_retry_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "request_deadline_us": {
              "$ref": "#/$defs/positiveTimeUs"
            },
            "state_timeout_us": {
              "$ref": "#/$defs/positiveTimeUs"
            }
          },
          "$comment": "All times are microseconds. LoadApplicationConfig requires request_deadline_us > request_retry_us, heartbeat_period_us < runtime.safety.timeouts.supervisor_us, target_period_us < min(command_us, source_state_us) and state_timeout_us <= runtime.safety.timeouts.source_state_us (the client's host-age freshness and the initializer's runtime-age usability rule must agree, or a snapshot can be fresh to the supervisor and unusable to the generator)."
        },
        "policy": {
          "type": "object",
          "required": ["model_path", "inference_timeout_us"],
          "properties": {
            "model_path": {
              "type": ["string", "null"],
              "$comment": "Path of the policy ONNX carrying the irmv.deployment contract. null means this deployment ships no local policy, which is the shipped Fake configuration; the local locomotion source is refused at startup without a path. The path is not a model identity: the model's own SHA-256 is what selects the overrides below."
            },
            "inference_timeout_us": {
              "$ref": "#/$defs/positiveTimeUs",
              "$comment": "microseconds; deadline of one policy step on the local source. Must exceed the model's policy_period_us, which LoadApplicationConfig cannot check because the period is a property of the loaded model."
            }
          },
          "$comment": "Where the local locomotion policy comes from. The gains themselves are not configured here: they are read from the model's own deployment contract, so the model stays the single source of the trained values."
        },
        "policy_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyOverrideSet"
          },
          "$comment": "Optional. Each entry records the differences agreed for exactly one model, matched by the complete SHA-256 of the model file and then by joint name; nothing here relaxes a runtime boundary."
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["intent_timeout_us", "repeat_guard_us", "bindings"],
      "properties": {
        "intent_timeout_us": {
          "$ref": "#/$defs/positiveTimeUs",
          "$comment": "microseconds; body-velocity intent expiry"
        },
        "repeat_guard_us": {
          "$ref": "#/$defs/positiveTimeUs",
          "$comment": "microseconds; one-shot key repeat suppression"
        },
        "bindings": {
          "type": "object",
          "required": [
            "emergency_stop",
            "damping",
            "initialize",
            "zero_torque",
            "reset",
            "exit"
          ],
          "additionalProperties": false,
          "properties": {
            "emergency_stop": {
              "const": " ",
              "$comment": "The reserved emergency-stop byte is the space character."
            },
            "damping": {
              "$ref": "#/$defs/keyByte"
            },
            "initialize": {
              "$ref": "#/$defs/keyByte"
            },
            "start_locomotion": {
              "$ref": "#/$defs/keyByte",
              "$comment": "Optional. Asks the Ready behaviour to propose the local policy as the new execution source; unbound means the behaviour cannot be asked for, which is what a deployment with no model wants."
            },
            "zero_torque": {
              "$ref": "#/$defs/keyByte"
            },
            "reset": {
              "$ref": "#/$defs/keyByte"
            },
            "exit": {
              "$ref": "#/$defs/keyByte"
            },
            "velocity_forward": {
              "$ref": "#/$defs/keyByte"
            },
            "velocity_backward": {
              "$ref": "#/$defs/keyByte"
            },
            "velocity_left": {
              "$ref": "#/$defs/keyByte"
            },
            "velocity_right": {
              "$ref": "#/$defs/keyByte"
            },
            "velocity_yaw_left": {
              "$ref": "#/$defs/keyByte"
            },
            "velocity_yaw_right": {
              "$ref": "#/$defs/keyByte"
            }
          },
          "$comment": "Action name -> one UTF-8 byte. LoadApplicationConfig rejects a byte bound to two actions and rejects the space byte on any action other than emergency_stop."
        }
      }
    },
    "telemetry": {
      "type": "object",
      "required": [
        "level",
        "directory",
        "rotate_bytes",
        "retained_files",
        "queue_capacity"
      ],
      "properties": {
        "level": {
          "enum": ["TRACE", "DEBUG", "INFO", "WARNING", "ERROR", "FATAL"]
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "rotate_bytes": {
          "$ref": "#/$defs/positiveTimeUs"
        },
        "retained_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "queue_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "dds": {
      "type": "object",
      "required": ["domain", "interface"],
      "properties": {
        "domain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 230
        },
        "interface": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "jointName": {
      "type": "string",
      "format": "irmv-joint-name",
      "minLength": 1,
      "maxLength": 64,
      "$comment": "The required irmv-joint-name format checker accepts exactly 1..64 UTF-8 encoded bytes; maxLength alone counts Unicode code points and is not sufficient."
    },
    "positiveTimeUs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "positiveJointMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/positiveNumber"
      }
    },
    "nonNegativeJointMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "positionJointMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "number"
      },
      "$comment": "rad; LoadApplicationConfig requires the keys to cover robot.joints exactly and every value to lie within that joint's [position_min, position_max]."
    },
    "policyOverrideSet": {
      "type": "object",
      "required": ["model_sha256", "joints"],
      "properties": {
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "$comment": "The complete SHA-256 of the policy ONNX file, lower case. LoadApplicationConfig refuses a value of another length or alphabet, and refuses two entries for the same digest (an override set that never applies is an error, not a silent no-op)."
        },
        "joints": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "kp": {
                "type": "number",
                "minimum": 0,
                "$comment": "N*m/rad, joint output side; the model's value is replaced, the runtime boundary still applies."
              },
              "kd": {
                "type": "number",
                "minimum": 0,
                "$comment": "N*m*s/rad; same rule as kp."
              }
            },
            "$comment": "At least one of kp and kd; a joint with neither is refused because it would record nothing."
          },
          "$comment": "Keyed by robot.joints[].name, the same names the model's deployment contract resolves its own joints against. LoadApplicationConfig requires every key to name a configured joint."
        }
      },
      "$comment": "The experimental gain differences of one model, matched by the model's complete SHA-256 and then per joint name. A model that is not listed runs with the values its own contract carries."
    },
    "initializationGainMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "required": ["kp", "kd"],
        "properties": {
          "kp": {
            "$ref": "#/$defs/positiveNumber",
            "$comment": "N*m/rad; an initialization joint must hold its target position, so kp > 0."
          },
          "kd": {
            "type": "number",
            "minimum": 0,
            "$comment": "N*m*s/rad"
          }
        }
      },
      "$comment": "LoadApplicationConfig requires the keys to cover robot.joints exactly."
    },
    "keyByte": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1,
      "pattern": "^[^ ]$",
      "$comment": "One character, never the reserved space byte. maxLength counts code points; LoadApplicationConfig additionally requires exactly one UTF-8 byte."
    }
  }
}
