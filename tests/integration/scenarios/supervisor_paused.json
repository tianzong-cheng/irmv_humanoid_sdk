{
  "name": "supervisor_paused",
  "description": "The supervisor is SIGSTOPped while tracking: the lease lapses on the supervisor timeout, no target survives it, and the supervisor has to make the whole handshake again after SIGCONT.",
  "domain": 205,
  "runtime": {
    "config": "config/sdk.json",
    "fake_scenario": "tests/support/fake_ramp.json",
    "output_trace": "trace_run%d.jsonl"
  },
  "steps": [
    {
      "action": "start_runtime"
    },
    {
      "action": "wait_log",
      "pattern": "state=\"ZeroTorque\"",
      "timeout_s": 15
    },
    {
      "action": "client",
      "name": "producer",
      "mode": "producer",
      "scenario": "producer",
      "background": true,
      "args": [
        "--producer-id",
        "0102030405060708090a0b0c0d0e0f33",
        "--rate",
        "50"
      ]
    },
    {
      "action": "client",
      "name": "observer",
      "mode": "observer",
      "scenario": "observe",
      "background": true
    },
    {
      "action": "client",
      "name": "supervisor",
      "mode": "supervisor",
      "scenario": "supervisor_paused",
      "background": true,
      "timeout_s": 30,
      "args": [
        "--producer-id",
        "0102030405060708090a0b0c0d0e0f33",
        "--rate",
        "50"
      ]
    },
    {
      "action": "wait_log",
      "pattern": "AuthorizationGranted",
      "timeout_s": 15
    },
    {
      "action": "signal_client",
      "name": "supervisor",
      "signal": "SIGSTOP"
    },
    {
      "action": "sleep_ms",
      "ms": 900,
      "note": "the supervisor timeout is 300 ms"
    },
    {
      "action": "signal_client",
      "name": "supervisor",
      "signal": "SIGCONT"
    },
    {
      "action": "wait_client",
      "name": "supervisor",
      "timeout_s": 30,
      "allow_exit": [
        0
      ]
    },
    {
      "action": "stop_runtime",
      "signal": "SIGTERM",
      "timeout_s": 10,
      "expect_clean": true
    },
    {
      "action": "signal_client",
      "name": "producer",
      "signal": "SIGTERM"
    },
    {
      "action": "wait_client",
      "name": "producer",
      "timeout_s": 15,
      "allow_exit": [
        0,
        -15
      ]
    },
    {
      "action": "signal_client",
      "name": "observer",
      "signal": "SIGTERM"
    },
    {
      "action": "wait_client",
      "name": "observer",
      "timeout_s": 15,
      "allow_exit": [
        0,
        -15
      ]
    }
  ],
  "checks": [
    {
      "check": "fallback",
      "params": {
        "client": "observer",
        "reason": "SupervisorTimeout",
        "state": "Damping",
        "session_revoked": true,
        "base": {
          "kind": "signal",
          "client": "supervisor",
          "signal": "SIGSTOP"
        },
        "min_ms": 200,
        "max_ms": 400
      }
    },
    {
      "check": "client_check",
      "params": {
        "client": "supervisor",
        "names": [
          "recovered_after_fallback",
          "session_acquired",
          "tracking_granted",
          "zero_torque_applied"
        ]
      }
    },
    {
      "check": "client_measurement",
      "params": {
        "client": "supervisor",
        "name": "recoveries",
        "min": 1
      }
    },
    {
      "check": "trace_complete",
      "params": {
        "file": "trace_run1.jsonl",
        "min_ticks": 1500
      }
    },
    {
      "check": "deadlines",
      "params": {
        "file": "trace_run1.jsonl",
        "max_gap_us": 10000,
        "min_rate_hz": 450
      }
    },
    {
      "check": "overruns",
      "params": {
        "max_worst_overrun_us": 20000
      }
    }
  ]
}
