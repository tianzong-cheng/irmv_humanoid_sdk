# The SDK revision embedded in every build, without a forced relink.
#
# The revision is a generated C++ source in the build tree:
#
#   <build>/generated/build_identity.cpp
#
# `irmv_add_build_identity(<library target>)` defines that library and an
# always-run `<target>_revision` target. The check target runs
# `git rev-parse HEAD` on every build; the generator compares the new source
# with the file already there and writes only when the revision changed. An
# unchanged repository therefore leaves the file's timestamp alone and does not
# cause a relink, while a new commit is compiled by the next incremental build.
#
# The module is also a generator script:
#
#   cmake -DIRMV_BUILD_IDENTITY_SOURCE_DIR=<source>
#         -DIRMV_BUILD_IDENTITY_OUTPUT=<build identity.cpp>
#         -P cmake/BuildIdentity.cmake
#
# That is the exact invocation the build target uses, and what the unit test
# drives against temporary repositories.
#
# The resolution is deliberately conservative. A source tree is accepted only
# when Git reports that the tree itself is the repository root: a copy whose
# .git was removed must not inherit the revision of whatever repository happens
# to contain it. Any failure - no Git, no repository, no commit - is "unknown",
# never a guessed or stale hash.

function(_irmv_build_identity_resolve source_dir out_sha)
  set(_sha "unknown")
  if(IS_DIRECTORY "${source_dir}")
    find_program(_irmv_git_executable git)
    if(_irmv_git_executable)
      execute_process(
        COMMAND "${_irmv_git_executable}" -C "${source_dir}" rev-parse
                --show-toplevel
        RESULT_VARIABLE _top_result
        OUTPUT_VARIABLE _top
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE
      )
      if(_top_result EQUAL 0 AND NOT _top STREQUAL "")
        get_filename_component(_source_real "${source_dir}" REALPATH)
        get_filename_component(_top_real "${_top}" REALPATH)
        if(_source_real STREQUAL _top_real)
          execute_process(
            COMMAND "${_irmv_git_executable}" -C "${source_dir}" rev-parse HEAD
            RESULT_VARIABLE _head_result
            OUTPUT_VARIABLE _head
            ERROR_QUIET
            OUTPUT_STRIP_TRAILING_WHITESPACE
          )
          if(_head_result EQUAL 0 AND _head MATCHES "^[0-9a-f]+$")
            set(_sha "${_head}")
          endif()
        endif()
      endif()
    endif()
  endif()
  set(${out_sha}
      "${_sha}"
      PARENT_SCOPE
  )
endfunction()

function(_irmv_build_identity_write sha output_file)
  set(
    _content
    "// Generated by cmake/BuildIdentity.cmake from git rev-parse HEAD.
// Do not edit: the build regenerates this file when the revision changes.
#include <string_view>

#include \"irmv/build_identity.hpp\"

namespace irmv {
namespace {
constexpr char kSdkGitSha[] = \"${sha}\";
}  // namespace

std::string_view SdkGitSha() noexcept {
  return std::string_view(kSdkGitSha, sizeof(kSdkGitSha) - 1);
}
}  // namespace irmv
"
  )
  set(_existing "")
  if(EXISTS "${output_file}")
    file(READ "${output_file}" _existing)
  endif()
  if(NOT _existing STREQUAL _content)
    get_filename_component(_directory "${output_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${_directory}")
    file(WRITE "${output_file}" "${_content}")
  endif()
endfunction()

# Defines `<target>` as a static library carrying the generated revision. The
# source directory defaults to the including project's source tree; the second
# argument overrides it, which is how the test points the same module at a
# temporary repository.
function(irmv_add_build_identity target)
  if(TARGET "${target}")
    return()
  endif()
  set(_source_dir "${PROJECT_SOURCE_DIR}")
  if(ARGC GREATER 1)
    set(_source_dir "${ARGV1}")
  endif()
  set(_generated "${CMAKE_BINARY_DIR}/generated/build_identity.cpp")
  set(_stamp "${CMAKE_BINARY_DIR}/generated/build_identity_check.stamp")
  set(_module "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BuildIdentity.cmake")

  # Generate at configure time so the source exists when the library target is
  # created. Both the configure-time write and the build-time rule content-
  # compare, so neither touches the file for an unchanged revision and no
  # relink is forced.
  _irmv_build_identity_resolve("${_source_dir}" _sha)
  _irmv_build_identity_write("${_sha}" "${_generated}")

  # The check target touches a stamp on every build; the generated source
  # depends on that stamp, so its rule runs every build as well. Declaring the
  # stamp as a byproduct is what makes the generator-independent ordering
  # explicit: the file dependency, not only a target-level ordering, tells both
  # Make and Ninja to run the check first and to re-examine the generated source
  # afterwards. Because the generator leaves an unchanged file's timestamp
  # alone, restat-aware generators stop there and do not relink.
  add_custom_target(
    "${target}_revision" ALL
    COMMAND "${CMAKE_COMMAND}" -E touch "${_stamp}"
    BYPRODUCTS "${_stamp}"
    COMMENT "Checking the SDK git revision"
    VERBATIM
  )
  add_custom_command(
    OUTPUT "${_generated}"
    COMMAND
      "${CMAKE_COMMAND}"
      "-DIRMV_BUILD_IDENTITY_SOURCE_DIR=${_source_dir}"
      "-DIRMV_BUILD_IDENTITY_OUTPUT=${_generated}"
      -P "${_module}"
    DEPENDS "${_stamp}" "${_module}"
    COMMENT "Recording the SDK git revision"
    VERBATIM
  )

  add_library("${target}" STATIC "${_generated}")
  add_dependencies("${target}" "${target}_revision")
  target_compile_features("${target}" PRIVATE cxx_std_17)
  target_include_directories(
    "${target}"
    PUBLIC "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>"
  )
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
  if(NOT DEFINED IRMV_BUILD_IDENTITY_SOURCE_DIR
     OR NOT DEFINED IRMV_BUILD_IDENTITY_OUTPUT
  )
    message(
      FATAL_ERROR
        "BuildIdentity.cmake needs IRMV_BUILD_IDENTITY_SOURCE_DIR and "
        "IRMV_BUILD_IDENTITY_OUTPUT in script mode"
    )
  endif()
  _irmv_build_identity_resolve("${IRMV_BUILD_IDENTITY_SOURCE_DIR}" _sha)
  _irmv_build_identity_write("${_sha}" "${IRMV_BUILD_IDENTITY_OUTPUT}")
  return()
endif()
