{
  "name": "runtime_restarted",
  "description": "The runtime is stopped and started again with a new instance identity: the packets of the previous instance are answered as foreign and the fresh instance never enters Tracking on its own.",
  "domain": 207,
  "runtime": {
    "config": "config/sdk.json",
    "fake_scenario": "tests/support/fake_scenario.json",
    "output_trace": "trace_run%d.jsonl"
  },
  "steps": [
    {
      "action": "start_runtime"
    },
    {
      "action": "wait_log",
      "pattern": "state=\"ZeroTorque\"",
      "timeout_s": 15
    },
    {
      "action": "client",
      "name": "record",
      "mode": "supervisor",
      "scenario": "runtime_restarted_record",
      "timeout_s": 30,
      "args": [
        "--producer-id",
        "0102030405060708090a0b0c0d0e0f33",
        "--rate",
        "50",
        "--replay",
        "packets.jsonl"
      ]
    },
    {
      "action": "sleep_ms",
      "ms": 600,
      "note": "the lease of the first instance expires"
    },
    {
      "action": "restart_runtime",
      "timeout_s": 10
    },
    {
      "action": "sleep_ms",
      "ms": 300
    },
    {
      "action": "wait_log",
      "pattern": "state=\"ZeroTorque\"",
      "timeout_s": 15
    },
    {
      "action": "client",
      "name": "replay",
      "mode": "supervisor",
      "scenario": "runtime_restarted_replay",
      "timeout_s": 30,
      "args": [
        "--replay",
        "packets.jsonl"
      ]
    },
    {
      "action": "stop_runtime",
      "signal": "SIGTERM",
      "timeout_s": 10,
      "expect_clean": true
    }
  ],
  "checks": [
    {
      "check": "instance_changed",
      "params": {
        "record_client": "record",
        "replay_client": "replay"
      }
    },
    {
      "check": "replay_rejected",
      "params": {
        "client": "replay",
        "reasons": [
          "WrongInstance",
          "WrongSession",
          "EpochMismatch",
          "StaleRequest",
          "InvalidTransition",
          "Malformed"
        ],
        "scope": "all"
      }
    },
    {
      "check": "replay_no_authorization",
      "params": {
        "client": "replay"
      }
    },
    {
      "check": "client_check",
      "params": {
        "client": "replay",
        "names": [
          "replayed_session_scoped_rejected",
          "no_automatic_tracking"
        ]
      }
    },
    {
      "check": "trace_complete",
      "params": {
        "file": "trace_run1.jsonl",
        "min_ticks": 500
      }
    },
    {
      "check": "trace_complete",
      "params": {
        "file": "trace_run2.jsonl",
        "min_ticks": 500
      }
    },
    {
      "check": "overruns",
      "params": {
        "max_worst_overrun_us": 20000
      }
    }
  ]
}
