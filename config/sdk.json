  "input": {
    "intent_timeout_us": 500000,
    "repeat_guard_us": 250000,
    "bindings": {
      "emergency_stop": " ",
      "damping": "d",
      "initialize": "i",
      "start_locomotion": "l",
      "zero_torque": "z",
      "reset": "r",
      "exit": "x",
      "velocity_forward": "w",
      "velocity_backward": "s",
      "velocity_left": "a",
      "velocity_right": "f",
      "velocity_yaw_left": "q",
      "velocity_yaw_right": "e"
    }
